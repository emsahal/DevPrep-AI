# ========================================================
# DevPrep AI — Docker Environment Variables
# Copy to .env and update values before running docker-compose
# ========================================================

# Backend
NODE_ENV=development
PORT=5000

# Database (matches the postgres service in docker-compose)
DATABASE_URL=postgresql://devprep:devprep_secret@postgres:5432/interview_prep?schema=public
POSTGRES_USER=devprep
POSTGRES_PASSWORD=devprep_secret
POSTGRES_DB=interview_prep

# Redis (matches the redis service in docker-compose)
REDIS_URL=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=docker-dev-access-secret-change-in-production
JWT_REFRESH_SECRET=docker-dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# CORS
FRONTEND_URL=http://localhost:3000
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
