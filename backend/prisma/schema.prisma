generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  password       String
  avatar         String?
  refreshToken   String?
  role           String   @default("user")
  emailVerified  Boolean  @default(false)
  learningPrefs  Json?
  completedTopics String[] @default([])
  savedResources String[] @default([])
  bookmarks      String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions       Session[]
  quizAttempts   QuizAttempt[]
  flashcardProgress FlashcardProgress[]
  stats          UserStats?
  badges         UserBadge[]
  sentRequests   MatchRequest[]     @relation("MatchRequestFrom")
  receivedRequests MatchRequest[]   @relation("MatchRequestTo")
  duelsAsPlayer1  Duel[]            @relation("DuelPlayer1")
  duelsAsPlayer2  Duel[]            @relation("DuelPlayer2")
  notifications   Notification[]
  resumes          Resume[]
  coverLetters     CoverLetter[]
  creditTransactions CreditTransaction[]
  reviews            Review[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Technology {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String
  category    String
  icon        String
  color       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics      Topic[]
  learningPaths LearningPathTechnology[]
}

model Topic {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  description  String
  content      String   @db.Text
  category     String
  technologyId String
  difficulty   String   @default("beginner")
  order        Int      @default(0)
  isPublished  Boolean  @default(true)
  aiGenerated  Boolean  @default(false)
  aiGeneratedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  technology     Technology     @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  quizzes        Quiz[]
  flashCards     FlashCard[]
  revisionNotes  RevisionNote[]
  userProgress   UserProgress[]

  @@index([technologyId])
  @@index([slug])
}

model Quiz {
  id          String   @id @default(uuid())
  title       String
  description String
  topicId     String
  difficulty  String   @default("beginner")
  timeLimit   Int      @default(300)
  passingScore Int     @default(70)
  isDaily     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic        Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions    Question[]
  quizAttempts QuizAttempt[]

  @@index([topicId])
}

model Question {
  id            String   @id @default(uuid())
  quizId        String
  text          String
  options       String[]
  correctAnswer Int
  explanation   String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  quiz          Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(uuid())
  userId    String
  quizId    String
  score     Int
  answers   Json?
  completed Boolean  @default(false)
  startedAt DateTime @default(now())
  completedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

model FlashCard {
  id         String   @id @default(uuid())
  front      String
  back       String
  topicId    String
  difficulty String   @default("beginner")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topic      Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress   FlashcardProgress[]

  @@index([topicId])
}

model FlashcardProgress {
  id        String   @id @default(uuid())
  userId    String
  flashCardId String
  status    String   @default("new") // new, learning, reviewing, mastered
  easeFactor Float    @default(2.5)
  interval  Int      @default(0)
  repetitions Int    @default(0)
  nextReview DateTime?
  lastReview DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashCard FlashCard @relation(fields: [flashCardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashCardId])
  @@index([userId])
  @@index([flashCardId])
}

model RevisionNote {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  summary   String?
  topicId   String
  userId    String?
  type      String   @default("note") // note, summary, cheat-sheet
  tags      String[] @default([])
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([userId])
}

model LearningPath {
  id          String   @id @default(uuid())
  title       String   @unique
  slug        String   @unique
  description String
  icon        String   @default("book-open")
  color       String   @default("from-blue-500 to-cyan-500")
  category    String   @default("development")
  difficulty  String   @default("beginner")
  estimatedHours Int   @default(0)
  topicCount  Int      @default(0)
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  technologies LearningPathTechnology[]
}

model LearningPathTechnology {
  id             String @id @default(uuid())
  learningPathId String
  technologyId   String
  order          Int    @default(0)

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  technology   Technology   @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, technologyId])
  @@index([learningPathId])
  @@index([technologyId])
}

model UserProgress {
  id        String   @id @default(uuid())
  userId    String
  topicId   String
  completed Boolean  @default(false)
  hasRead   Boolean  @default(false)
  score     Int?
  timeSpent Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
}

model ChatHistory {
  id        String   @id @default(uuid())
  userId    String
  sessionId String
  role      String   // user, assistant
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, sessionId])
  @@index([sessionId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  topicId   String?
  noteId    String?
  flashCardId String?
  type      String   // topic, note, flashcard
  createdAt DateTime @default(now())

  @@unique([userId, topicId, type])
  @@index([userId])
}

model UserStats {
  id              String   @id @default(uuid())
  userId          String   @unique
  totalPoints     Int      @default(0)
  weeklyPoints    Int      @default(0)
  xp              Int      @default(0)
  level           Int      @default(1)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActivityDate DateTime?
  weeklyPointsArchived Json?  @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointTransactions PointTransaction[]

  @@index([totalPoints])
  @@index([weeklyPoints])
}

model Badge {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  iconUrl     String?
  criteria    Json
  createdAt   DateTime @default(now())

  users UserBadge[]
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model PointTransaction {
  id            String   @id @default(uuid())
  userId        String
  amount        Int
  reason        String
  referenceType String?
  referenceId   String?
  multiplier    Float    @default(1.0)
  streakDays    Int      @default(0)
  createdAt     DateTime @default(now())

  userStats UserStats @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model MatchRequest {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String?
  mode       String
  topic      String
  status     String   @default("pending") // pending | accepted | declined | expired | cancelled
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  respondedAt DateTime?

  fromUser User  @relation("MatchRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User? @relation("MatchRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)
  duel     Duel?

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status, mode, topic])
}

model Duel {
  id             String   @id @default(uuid())
  matchRequestId String   @unique
  mode           String
  topic          String
  player1Id      String
  player2Id      String
  content        Json
  answers        Json?
  score1         Int?
  score2         Int?
  winnerId       String?
  status         String   @default("in_progress") // in_progress | completed | forfeited | disconnected
  startedAt      DateTime @default(now())
  endedAt        DateTime?
  createdAt      DateTime @default(now())

  matchRequest MatchRequest @relation(fields: [matchRequestId], references: [id], onDelete: Cascade)
  player1      User         @relation("DuelPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2      User         @relation("DuelPlayer2", fields: [player2Id], references: [id], onDelete: Cascade)

  @@index([player1Id])
  @@index([player2Id])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Resume {
  id              String   @id @default(uuid())
  userId          String
  title           String   @default("Untitled Resume")
  originalText    String   @db.Text
  originalFilePath String?
  parsedData      Json?
  optimizedText   String?  @db.Text
  optimizedData   Json?
  atsScore        Int?
  matchScore      Int?
  missingSkills   String[]
  missingKeywords String[]
  suggestions     Json?
  jobTitle        String?
  jobDescription  String?  @db.Text
  interviewChance Int?
  template        String   @default("classic")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverLetters CoverLetter[]

  @@index([userId])
}

model CoverLetter {
  id        String   @id @default(uuid())
  userId    String
  resumeId  String
  content   String   @db.Text
  template  String   @default("modern")
  company   String?
  jobTitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreditTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  type      String   // "usage" | "purchase" | "bonus"
  reference String?  // resumeId or payment reference
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  role      String
  rating    Int
  text      String   @db.Text
  initials  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

